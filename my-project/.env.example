# Required in deployed environments. Never commit actual values.
# Percent-encode reserved characters in the username and password (for example, @ as %40).
MONGODB_URI=mongodb+srv://USERNAME:PERCENT_ENCODED_PASSWORD@CLUSTER_HOST/
MONGODB_DB=freelanceflow
TEST_MONGODB_URI=
TEST_MONGODB_DB=freelanceflow_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# JWT settings are for the staged custom-auth migration; do not activate them until database access is verified.
JWT_ACCESS_SECRET=
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=freelanceflow
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Required for distributed production rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Number of trusted reverse-proxy hops before the real client IP.
# Leave 0 unless your platform overwrites X-Forwarded-For.
TRUST_PROXY_HOPS=0
# Alternative exact-IP allowlist for trusted proxies (comma-separated).
TRUSTED_PROXY_IPS=
# Email delivery is mandatory for production verification and recovery flows.
# Use EMAIL_PROVIDER=test only under NODE_ENV=test.
EMAIL_PROVIDER=emailjs
EMAIL_FROM=

# EmailJS Server-Side Configuration (Password Reset & Notifications)
# Obtain these values from https://dashboard.emailjs.com/
# IMPORTANT: in EmailJS dashboard, open Account -> Security and enable "Allow server-side API requests".
# The reset template must contain {{to_email}}, {{to_name}}, {{reset_url}},
# {{expires_minutes}}, {{product_name}} and {{support_email}}.
EMAILJS_SERVICE_ID=service_z9m7rm8
EMAILJS_TEMPLATE_ID_PASSWORD_RESET=template_prr7tcg
EMAILJS_PUBLIC_KEY=ViBCe7pkFILOOTUur
EMAILJS_PRIVATE_KEY=M8Uvm4xjAl8F6SrrIfICU
EMAILJS_TIMEOUT_MS=8000
# Explicit opt-in required before npm run email:test may send a live message.
ALLOW_EMAILJS_TEST_SEND=false
# Development-only. NEVER enable in production. Writes reset links to the
# gitignored .dev-reset-links.jsonl file instead of calling EmailJS.
ALLOW_DEV_RESET_LINK=false
EMAIL_TEST_RECIPIENT=
# Trusted origin used to construct password reset links
APP_BASE_URL=http://localhost:3000

# S3-Compatible File Storage (Amazon S3, Cloudflare R2, MinIO)
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Max upload size in bytes (default 20MB: 20971520)
MAX_FILE_SIZE_BYTES=20971520

# Demo seeding only. SEED_MONGODB_URI never falls back to MONGODB_URI.
SEED_MONGODB_URI=
SEED_ORGANIZATION_ID=
SEED_OWNER_USER_ID=
SEED_ALLOW_DEMO_DATABASE=false
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=
